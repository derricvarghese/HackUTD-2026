    <!-- Onboarding -->
    <string name="onboarding_title">Reach help even when networks fail</string>
    <string name="onboarding_body">Beacon passes signed SOS messages between nearby phones over Bluetooth until one of them has internet. Set this up now, so it is ready when you need it.</string>
    <string name="onboarding_continue">Start relaying</string>
    <string name="onboarding_skip">Skip for now</string>
    <string name="onboarding_blocked">Allow Bluetooth access and turn Bluetooth on to start the mesh.</string>
    <string name="perm_bluetooth_title">Nearby devices (Bluetooth)</string>
    <string name="perm_bluetooth_why">Lets your phone find, connect to and relay messages for other phones around you. No pairing needed.</string>
    <string name="service_bluetooth_title">Bluetooth is on</string>
    <string name="service_bluetooth_why">The mesh runs over Bluetooth Low Energy. It works in airplane mode as long as Bluetooth stays on.</string>
    <string name="perm_location_title">Precise location</string>
    <string name="perm_location_why">Attaches your GPS position to an alert so responders can find you. Optional, but strongly recommended.</string>
    <string name="perm_location_why_required">Android 11 and older only allow Bluetooth scanning with location access. It also attaches your GPS position to alerts.</string>
    <string name="service_location_title">Location services are on</string>
    <string name="service_location_why">GPS must be switched on to get a position fix for your alerts.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_why">Shows that Beacon is relaying in the background, so Android keeps it running with the screen off.</string>
    <string name="perm_denied_rationale">Without this permission the feature cannot work. You can allow it now.</string>
    <string name="perm_denied_permanent">Android will no longer ask. Open app settings, choose Permissions and allow it there.</string>

