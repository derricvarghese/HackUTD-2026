<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE = YES). -->
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Beacon</string>
    <key>CFBundleName</key>
    <string>Beacon</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Beacon passes SOS messages from phone to phone over Bluetooth when cell service is down.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Beacon attaches your location to SOS messages, encrypted so only responders can read it.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Beacon lets you attach photos of damage or injuries to your SOS report.</string>
    <key>NSCameraUsageDescription</key>
    <string>Beacon lets you take photos to attach to your SOS report.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
        <string>bluetooth-peripheral</string>
    </array>
    <!-- Backend settings, filled from the Xcode build settings of the same names (Build Settings > User-Defined).
         BEACON_ENC_PUBLIC_KEY / BEACON_SIGN_PUBLIC_KEY are the server's public keys (base64 X.509 SPKI) so a phone that
         has never been online can still encrypt. Override them with an xcconfig or -BEACON_ENC_PUBLIC_KEY=... -->
    <key>BEACON_BACKEND_URL</key>
    <string>$(BEACON_BACKEND_URL)</string>
    <key>BEACON_ENC_PUBLIC_KEY</key>
    <string>$(BEACON_ENC_PUBLIC_KEY)</string>
    <key>BEACON_SIGN_PUBLIC_KEY</key>
    <string>$(BEACON_SIGN_PUBLIC_KEY)</string>
</dict>
</plist>
