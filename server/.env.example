PORT=3000
DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon
JWT_SECRET=change-me-to-a-long-random-string
# generate with: npm run keys
BACKEND_ENC_PRIVATE_KEY=
BACKEND_SIGN_PRIVATE_KEY=
# leave NEMOTRON_BASE_URL empty to use the built-in stub triage provider
NEMOTRON_BASE_URL=
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron
DEMO_MODE=false
SEED_ON_START=true
SEED_PASSWORD=beacon-demo
# global per-IP rate limit (requests/minute), per-device heartbeat limit, abuse flag threshold (cases/hour)
IP_RATE_PER_MIN=600
HEARTBEAT_RATE_PER_MIN=12
CASES_PER_HOUR_FLAG=20
# background jobs: unset = on except NODE_ENV=test
JOBS_ENABLED=
# DEADZONE_QUIET_S=1800  DEADZONE_CELL_KM=1  DEADZONE_MIN_ACTIVE_NEIGHBORS=5  NEIGHBOR_K=3  CHECKIN_MAX_ATTEMPTS=10
# Liveness. Heartbeats are automatic; no heartbeat for SILENCE_THRESHOLD_S = lost contact (open SOS => case silent).
# HEARTBEAT_INTERVAL_S=300  SILENCE_THRESHOLD_S=1200
# Welfare check-ins for open SOS cases: interval per tier and time to answer
# CHECKIN_INTERVAL_CRITICAL_S=600  CHECKIN_INTERVAL_HIGH_S=900  CHECKIN_INTERVAL_S=1800  CHECKIN_WINDOW_S=300  CHECKIN_REMINDER_S=300  CHECKIN_REMINDER_SLOW_S=900
# Optional push for check-ins (FCM HTTP v1). Needs Firebase credentials; unset = logging no-op provider (apps still notify locally).
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# Victim identity profiles (personal data). The sensitive part is AES-256-GCM encrypted at rest with a key derived (HKDF-SHA256) from PROFILE_ENC_KEY,
# falling back to JWT_SECRET so existing deployments keep working. In production set PROFILE_ENC_KEY (any long random string, e.g. `openssl rand -base64 32`)
# and never change it: rotating the secret it derives from makes stored profiles unreadable. full_name / birth_year stay queryable in clear text by design.
PROFILE_ENC_KEY=
# profiles with no case, not updated and whose device was not seen for this many days are deleted by the hourly purgeTick
PROFILE_RETENTION_DAYS=90
# advertised in /server-info: onboarding must collect name + consent; bump the consent version to force users to re-consent
PROFILE_REQUIRED=true
PROFILE_CONSENT_VERSION=2026-11-v1
PROFILE_WRITE_RATE_PER_MIN=10
# Nemotron 3.x is a reasoning model: thinking stays OFF for triage (it otherwise returns empty content).
# NEMOTRON_ENABLE_THINKING=false
# NEMOTRON_BASE_URL may omit the /v1 suffix; the server appends it.
# per-call (and per AI-triage job) timeout in ms
# NEMOTRON_TIMEOUT_MS=4000
# AI triage runs in the background after a case is stored and shown with its rules score (triage_status provisional -> complete/failed).
# workers calling the LLM at once, attempts per round and the delay before attempts 2, 3, ... (ms)
AI_TRIAGE_CONCURRENCY=4
AI_TRIAGE_MAX_ATTEMPTS=3
AI_TRIAGE_BACKOFF_MS=2000,8000,30000
# sweep that recovers stuck cases (also run on boot) and retries failed ones: every AI_TRIAGE_SWEEP_S; a failed case gets a new round every
# AI_TRIAGE_FAILED_RETRY_S, at most AI_TRIAGE_FAILED_MAX_SWEEPS times; cases requested more than AI_TRIAGE_MAX_AGE_H hours ago are left alone
AI_TRIAGE_SWEEP_S=30
AI_TRIAGE_FAILED_RETRY_S=300
AI_TRIAGE_FAILED_MAX_SWEEPS=6
AI_TRIAGE_MAX_AGE_H=24
# how often a waiting job re-checks the LLM circuit breaker while it is open (ms)
AI_TRIAGE_BREAKER_WAIT_MS=5000
# artificial latency for the offline stub LLM so the provisional -> final change is visible; defaults to 1500 when DEMO_MODE=true, else 0
# AI_TRIAGE_DEMO_DELAY_MS=1500
# Case photos (JPEG/PNG, metadata stripped on the server): max bytes per image, max images per case, uploads per minute per device/responder
IMAGE_MAX_BYTES=3145728
IMAGE_MAX_PER_CASE=6
IMAGE_UPLOAD_RATE_PER_MIN=20

# ---- Dispatch agent (Nemotron tool-calling loop that proposes a dispatch; a human approves) ----
# default: on when NEMOTRON_BASE_URL is set, off with the stub LLM
# AGENT_ENABLED=true
# model turns per run (the last one can only submit), total run budget in ms, per LLM call budget in ms
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_MS=25000
# AGENT_LLM_TIMEOUT_MS=15000
# runs at once (the GPU is shared)
AGENT_CONCURRENCY=2
# Nemotron thinking mode for the agent (slower)
AGENT_THINKING=false
# false disables every external HTTP tool (NWS, USGS/NWPS, FEMA, OSRM, Nominatim, Overpass)
AGENT_EXTERNAL_TOOLS=true
# AGENT_TOOL_TIMEOUT_EXTERNAL_MS=6000
# AGENT_TOOL_TIMEOUT_INTERNAL_MS=2000
# at most one automatic re-run per case in this window (seconds); manual re-runs are exempt
AGENT_RERUN_MIN_S=120
# AGENT_SWEEP_S=60
# DEMO_MODE only: inject a recorded NWS flash flood warning and a rising gauge into the weather/river tools (labelled synthetic)
# AGENT_DEMO_WEATHER=flash_flood
# Facilities (hospitals, fire stations) are fetched from Overpass in the background when an event is created or its geofence changes
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# OVERPASS_TIMEOUT_MS=30000
# FACILITIES_MAX_ATTEMPTS=4
# FACILITIES_BACKOFF_MS=5000,30000,120000
# Responder presence: an app that has not been seen for this long (seconds) is no longer in the field (in_app=false, available=false). DEMO_MODE default: 30
# RESPONDER_PRESENCE_TIMEOUT_S=180
# The dispatch agent prefers in-app responders whose position is newer than this (seconds)
# RESPONDER_POSITION_FRESH_S=900
