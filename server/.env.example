PORT=3000
DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon
JWT_SECRET=change-me-to-a-long-random-string
# generate with: npm run keys
BACKEND_ENC_PRIVATE_KEY=
BACKEND_SIGN_PRIVATE_KEY=
# leave NEMOTRON_BASE_URL empty to use the built-in stub triage provider
NEMOTRON_BASE_URL=
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron
DEMO_MODE=false
SEED_ON_START=true
SEED_PASSWORD=beacon-demo
# global per-IP rate limit (requests/minute), per-device heartbeat limit, abuse flag threshold (cases/hour)
IP_RATE_PER_MIN=600
HEARTBEAT_RATE_PER_MIN=12
CASES_PER_HOUR_FLAG=20
# background jobs: unset = on except NODE_ENV=test
JOBS_ENABLED=
# DEADZONE_QUIET_S=1800  DEADZONE_CELL_KM=1  DEADZONE_MIN_ACTIVE_NEIGHBORS=5  NEIGHBOR_K=3  CHECKIN_MAX_ATTEMPTS=10
# Victim identity profiles (personal data). The sensitive part is AES-256-GCM encrypted at rest with a key derived (HKDF-SHA256) from PROFILE_ENC_KEY,
# falling back to JWT_SECRET so existing deployments keep working. In production set PROFILE_ENC_KEY (any long random string, e.g. `openssl rand -base64 32`)
# and never change it: rotating the secret it derives from makes stored profiles unreadable. full_name / birth_year stay queryable in clear text by design.
PROFILE_ENC_KEY=
# profiles with no case, not updated and whose device was not seen for this many days are deleted by the hourly purgeTick
PROFILE_RETENTION_DAYS=90
# advertised in /server-info: onboarding must collect name + consent; bump the consent version to force users to re-consent
PROFILE_REQUIRED=true
PROFILE_CONSENT_VERSION=2026-11-v1
PROFILE_WRITE_RATE_PER_MIN=10
# Nemotron 3.x is a reasoning model: thinking stays OFF for triage (it otherwise returns empty content).
# NEMOTRON_ENABLE_THINKING=false
# NEMOTRON_BASE_URL may omit the /v1 suffix; the server appends it.
